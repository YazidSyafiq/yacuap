# Salin file ini jadi .env.local lalu isi nilainya. .env.local tidak ikut ke git.

# URL publik situs. Dipakai untuk OG image, sitemap, RSS, dan kartu share.
# Lokal: http://localhost:3000 · Vercel: https://<project>.vercel.app · nanti: domain sendiri
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Satu project dipakai untuk pengembangan DAN produksi, jadi dua nilai ini
# sama persis di laptop dan di Vercel. Ambil dari dashboard: Project Settings > API.
# Publishable key aman dipakai di browser; akses data dijaga RLS.
# Jangan pernah menaruh service role key atau kata sandi database di file env proyek ini.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
